# Student Progress Tracker — Environment Variables
# Copy this file to .env and fill in your values

# Application
VITE_APP_NAME="Student Progress Tracker"
VITE_APP_VERSION=0.1.0
VITE_APP_ENV=development

# API Configuration
VITE_API_BASE_URL=http://localhost:3001/api
VITE_API_TIMEOUT=10000
VITE_API_MOCK_ENABLED=true

# Authentication
VITE_AUTH_TOKEN_KEY=student_tracker_auth
VITE_AUTH_REDIRECT_KEY=student_tracker_redirect
VITE_AUTH_REMEMBER_DAYS=30
VITE_SESSION_TIMEOUT_MINUTES=60

# Features
VITE_ENABLE_MOCK_API=true
VITE_ENABLE_PWA=false
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_NOTIFICATIONS=true

# Performance
VITE_CACHE_TTL_SECONDS=300

# Chart.js
VITE_CHART_ANIMATION_DURATION=750
VITE_CHART_RESPONSIVE=true