{
  "name": "student-progress-tracker",
  "version": "1.0.0",
  "description": "A web-based platform designed to help students and educators monitor academic performance, track assignments, and analyze learning progress.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "node scripts/build.js",
    "preview": "npx serve dist -p 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:a11y": "playwright test tests/e2e/a11y.test.js",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{js,css,html}\"",
    "format:check": "prettier --check \"src/**/*.{js,css,html}\"",
    "prepare": "husky",
    "deploy": "node scripts/build.js --base /student-progress-tracker/ --env production && git add -f dist && git commit -m \"chore: deploy to gh-pages\" && git push origin `git subtree split --prefix dist HEAD`:gh-pages --force"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LeapX-Pune/student-progress-tracker.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/LeapX-Pune/student-progress-tracker/issues"
  },
  "homepage": "https://leapx-pune.github.io/student-progress-tracker/",
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.11",
    "@testing-library/dom": "10.4.1",
    "@vitest/coverage-v8": "^4.1.10",
    "axe-core": "4.12.1",
    "esbuild": "0.28.1",
    "eslint": "10.7.0",
    "eslint-plugin-import-x": "^4.0.0",
    "eslint-plugin-jsdoc": "63.2.0",
    "eslint-plugin-promise": "7.3.0",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "json-server": "^0.17.4",
    "lint-staged": "17.1.0",
    "msw": "2.15.0",
    "playwright": "1.61.1",
    "prettier": "3.9.6",
    "serve": "14.2.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions"
  ],
  "vitest": {
    "coverage": {
      "provider": "v8",
      "thresholds": {
        "lines": 70
      }
    }
  },
  "dependencies": {
    "chart.js": "^4.4.7",
    "lucide": "^1.31.0"
  }
}
